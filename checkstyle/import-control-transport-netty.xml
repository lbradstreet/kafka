<import-control pkg="org.apache.kafka">

    <!-- common library dependencies -->
    <allow pkg="java" />
    <allow pkg="javax.net.ssl" />
    <allow pkg="javax.security" />
    <allow pkg="org.slf4j" />
    <allow pkg="org.junit" />
    <allow pkg="org.mockito" />

    <!-- the transport is built on netty -->
    <allow pkg="io.netty" />

    <!-- protocol, security and utility layers of the clients module are reused verbatim;
         the classic client implementation (org.apache.kafka.clients.**) must NOT leak in.
         NodeApiVersions is the single, deliberate exception: it is the protocol-negotiation
         value type, not client machinery. -->
    <allow pkg="org.apache.kafka.common" />
    <allow class="org.apache.kafka.clients.NodeApiVersions" />
    <!-- clients test fixtures -->
    <allow pkg="org.apache.kafka.test" />

    <subpackage name="network">
        <subpackage name="netty">
            <allow pkg="org.apache.kafka.network.netty" />
        </subpackage>
    </subpackage>

</import-control>
